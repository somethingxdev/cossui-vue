    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-slop": "^0.1.3",
